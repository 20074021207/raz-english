# ====================================================================
# Gitignore Optimization (Security First)
# ====================================================================

# 1. Credentials & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
*.keystore
credentials.json
client_secret.json

# 2. Local Databases
*.sqlite
*.sqlite3
*.db

# 3. Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# 4. Expo & React Native Build Outputs
.expo/
dist/
build/
web-build/
expo-env.d.ts
/app/ios/
/app/android/
.kotlin/
*.orig.*

# 5. Logs & Temporary Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.metro-health-check*
.eslintcache
*.tsbuildinfo

# 6. IDE & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/
*.swp
*.swo

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
